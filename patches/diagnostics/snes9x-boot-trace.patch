+// Read-only, local diagnostic instrumentation; never used by stock captures.
+static unsigned long long bm_line_clock;
+static unsigned bm_host_frame;
+static void bm_boot_trace(void) {
+    static FILE *out;
+    static bool initialized;
+    static unsigned previous_mode;
+    if (!initialized) {
+        initialized = true;
+        const char *path = getenv("BM_BOOT_TRACE");
+        if (path && *path) {
+            out = fopen(path, "w");
+            if (!out) abort();
+            fprintf(out, "frame,clock,pc,v,h,mode,counter13,m,x,apu_clock,spc_pc,timer0_prescaler,timer0_divider,timer0_counter,timer0_target,apu_out01\n");
+        }
+    }
+    if (!out) return;
+    if (Memory.RAM[0x100] == 3 || previous_mode == 3)
+        fprintf(out, "%u,%llu,%u,%d,%d,%u,%u,%d,%d,%u,%u,%u,%u,%u,%u,%u\n",
+                bm_host_frame, bm_line_clock + CPU.Cycles, Registers.PBPC,
+                CPU.V_Counter, CPU.Cycles, Memory.RAM[0x100], Memory.RAM[0x13],
+                !!CheckFlag(MemoryFlag), !!CheckFlag(IndexFlag),
+                0u, SNES::smp.regs.pc, SNES::smp.timer0.stage1_ticks,
+                SNES::smp.timer0.stage2_ticks, SNES::smp.timer0.stage3_ticks,
+                SNES::smp.timer0.target, SNES::smp.apuram[0xf4] | (unsigned(SNES::smp.apuram[0xf5]) << 8));
+    previous_mode = Memory.RAM[0x100];
+}
