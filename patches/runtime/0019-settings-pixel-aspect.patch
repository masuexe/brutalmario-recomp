 extern Snes *g_snes;
 
+void ChangeWindowScale(int scale_step);
+
 void snesrecomp_desktop_set_widescreen(int enabled) {
   g_config.widescreen = enabled != 0;
   WriteConfigFile(g_active_config_file);
 }
 
+static void SettingsSetDisplayAspect(uint8_t value) {
+  g_config.display_aspect = (uint8)SnesDisplayAspect_Clamp((int)value);
+  WriteConfigFile(g_active_config_file);
+  bool custom_size = g_config.window_width != 0 && g_config.window_height != 0;
+  if (g_window && !custom_size)
+    ChangeWindowScale(0);
+  fprintf(stderr, "[settings] display_aspect=%s\n",
+          SnesDisplayAspect_Name(g_config.display_aspect));
+}
+
+static void SettingsStepDisplayAspect(int delta) {
+  /* Cycle in friendly order: 8:7 (1:1 square) -> 4:3 (CRT) -> 1:1 (square frame). */
+  static const uint8_t kOrder[3] = {
+    kSnesDisplayAspect_SquarePixels8x7,
+    kSnesDisplayAspect_Crt4x3,
+    kSnesDisplayAspect_SquareFrame1x1,
+  };
+  int cur = SnesDisplayAspect_Clamp(g_config.display_aspect);
+  int idx = 0;
+  for (int i = 0; i < 3; ++i) {
+    if (kOrder[i] == (uint8_t)cur) { idx = i; break; }
+  }
+  idx = (idx + (delta < 0 ? 2 : 1)) % 3;
+  SettingsSetDisplayAspect(kOrder[idx]);
+}
