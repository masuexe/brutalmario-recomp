+/* Scope air-swim to a simulated frame. Keep the genuine level-water byte
+ * outside guest execution, so native tile collision decides swimming again
+ * on the first frame after the cheat is disabled. Never clear player $75. */
+static int g_cheat_swim_applied;
+static uint8_t g_cheat_water_natural;
+static uint16_t g_cheat_water_room;
+static void FinishCheatHolds(void) {
+  if (!g_cheat_swim_applied) return;
+  const uint16_t room = g_ram[0x10b] | (g_ram[0x10c] << 8);
+  /* A room loader owns the new room's water flag. Preserve its writes. */
+  if (room == g_cheat_water_room && g_ram[0x85] == 1)
+    g_ram[0x85] = g_cheat_water_natural;
+  g_cheat_swim_applied = 0;
+}
+
 static void TickCheatHolds(void) {
   if (g_cheat_invincible) g_ram[0x1490] = 0x40;
-  if (g_cheat_swim) g_ram[0x85] = 0x01;
+  if (g_cheat_swim && g_ram[0x100] == 0x14) {
+    g_cheat_water_natural = g_ram[0x85];
+    g_cheat_water_room = g_ram[0x10b] | (g_ram[0x10c] << 8);
+    g_cheat_swim_applied = 1;
+    g_ram[0x85] = 1;
+  }
 }
 
