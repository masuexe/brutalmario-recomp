+static void CheatKeyDown(int key, int repeat) {
+  (void)repeat;
+  if (key == SDLK_ESCAPE || key == SDLK_BACKQUOTE) {
+    g_cheat_console_open = 0;
+    return;
+  }
+  if (key == SDLK_BACKSPACE) {
+    const size_t len = strlen(g_cheat_input);
+    if (len) g_cheat_input[len - 1] = 0;
+    return;
+  }
+  if (key == SDLK_RETURN || key == SDLK_KP_ENTER) {
+    CheatExecute();
+    return;
+  }
+  char c = 0;
+  if (key >= SDLK_a && key <= SDLK_z) c = (char)('a' + (key - SDLK_a));
+  else if (key >= SDLK_0 && key <= SDLK_9) c = (char)('0' + (key - SDLK_0));
+  else if (key == SDLK_SPACE) c = ' ';
+  else if (key == SDLK_MINUS) c = '-';
+  if (!c) return;
+  const size_t len = strlen(g_cheat_input);
+  if (len + 1 < sizeof(g_cheat_input)) {
+    g_cheat_input[len] = c;
+    g_cheat_input[len + 1] = 0;
+  }
+}
