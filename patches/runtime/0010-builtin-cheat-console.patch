+static void CheatExecute(void) {
+  char command[sizeof(g_cheat_input)];
+  memcpy(command, g_cheat_input, sizeof(command));
+  command[sizeof(command) - 1] = 0;
+  char *name = strtok(command, " ");
+  if (!name) return;
+  fprintf(stderr, "[cheat] %s\n", name);
+  if (strcmp(name, "help") == 0) {
+    snprintf(g_cheat_status, sizeof(g_cheat_status),
+             "invincible | swim | lives N | music HEX | map M X Y | teleport ROOM | complete | close");
+  } else if (strcmp(name, "invincible") == 0) {
+    g_cheat_invincible = !g_cheat_invincible;
+    snprintf(g_cheat_status, sizeof(g_cheat_status), "invincible %s",
+             g_cheat_invincible ? "on" : "off");
+  } else if (strcmp(name, "swim") == 0) {
+    g_cheat_swim = !g_cheat_swim;
+    snprintf(g_cheat_status, sizeof(g_cheat_status), "swim %s",
+             g_cheat_swim ? "on" : "off");
+  } else if (strcmp(name, "lives") == 0) {
+    char *value = strtok(NULL, " ");
+    if (!value) {
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "usage: lives N");
+    } else {
+      g_ram[0x0dbe] = (uint8_t)strtol(value, NULL, 0);
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "lives %u", g_ram[0x0dbe]);
+    }
+  } else if (strcmp(name, "music") == 0) {
+    char *value = strtok(NULL, " ");
+    if (!value) {
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "usage: music HEX or music off");
+    } else if (strcmp(value, "off") == 0 || strcmp(value, "none") == 0) {
+      g_ram[0x0dda] = 0;
+      g_ram[0x1dfb] = 0;
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "music off");
+    } else {
+      const uint8_t slot = (uint8_t)strtol(value, NULL, 16);
+      g_ram[0x0dda] = slot;
+      g_ram[0x1dfb] = slot;
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "music %02X", slot);
+    }
+  } else if (strcmp(name, "map") == 0) {
+    char *m = strtok(NULL, " ");
+    char *x = strtok(NULL, " ");
+    char *y = strtok(NULL, " ");
+    if (!m || !x || !y) {
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "usage: map MAP X Y");
+    } else {
+      CheatQueueMap((int)strtol(m, NULL, 0) & 0xFF,
+                    (int)strtol(x, NULL, 0) & 0x1FF,
+                    (int)strtol(y, NULL, 0) & 0x1FF);
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "map queued");
+    }
+  } else if (strcmp(name, "teleport") == 0) {
+    char *room = strtok(NULL, " ");
+    if (!room) {
+      snprintf(g_cheat_status, sizeof(g_cheat_status), "usage: teleport ROOM");
+    } else {
+      const long value = strtol(room, NULL, 0);
+      if (value < 0 || value > 0x1FF) {
+        snprintf(g_cheat_status, sizeof(g_cheat_status), "room must be 0x000..0x1FF");
+      } else {
+        CheatQueueRoom((int)value);
+        snprintf(g_cheat_status, sizeof(g_cheat_status), "teleport queued for 0x%03lX", value);
+      }
+    }
+  } else if (strcmp(name, "complete") == 0) {
+    static const uint8_t flags[0x60] = {
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+      0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f, 0x9f,
+    };
+    static const uint8_t events[15] = {
+      0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+      0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff,
+    };
+    static const uint8_t switches[4] = {1, 1, 1, 1};
+    CheatQueuePoke(0x1ea2, flags, (int)sizeof(flags));
+    CheatQueuePoke(0x1f02, events, (int)sizeof(events));
+    CheatQueuePoke(0x1f27, switches, (int)sizeof(switches));
+    CheatQueueMap(6, 0x128, 0x1E8);
+    snprintf(g_cheat_status, sizeof(g_cheat_status), "completion queued");
+  } else if (strcmp(name, "close") == 0) {
+    g_cheat_console_open = 0;
+  } else {
+    snprintf(g_cheat_status, sizeof(g_cheat_status), "unknown command; type help");
+  }
+  g_cheat_input[0] = 0;
+}
+
+static void TickCheatHolds(void) {
