+static void RunCheatConsoleLoop(bool *running) {
+  g_cheat_console_open = 1;
+  g_cheat_input[0] = 0;
+  if (!g_cheat_batch_done) {
+    g_cheat_batch_done = 1;
+    const char *batch = HostGetenv("CHEAT_CONSOLE_COMMANDS");
+    if (batch && *batch) {
+      char copy[512];
+      snprintf(copy, sizeof(copy), "%s", batch);
+      char *part = copy;
+      while (part && *part) {
+        char *sep = strchr(part, ';');
+        if (sep) *sep = 0;
+        snprintf(g_cheat_input, sizeof(g_cheat_input), "%s", part);
+        CheatExecute();
+        if (!g_cheat_console_open) break;
+        part = sep ? sep + 1 : NULL;
+      }
+    }
+  }
+  g_overlay_modal = true;
+  SetAudioPaused(true);
+  host_report_breadcrumb("practice cheat console OPEN - guest frozen until it closes");
+  while (g_cheat_console_open && *running) {
+    PumpOverlayEvents(running, &CheatKeyDown);
+    PresentFrozenWithOverlay();
+    SDL_Delay(8);
+  }
+  g_cheat_console_open = 0;
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  host_report_breadcrumb("practice cheat console CLOSED - guest resuming");
+}
