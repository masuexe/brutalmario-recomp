+  snes_ovl_fill_rect(panel, kCheatPanelW, kCheatPanelH, 0, 0,
+                     kCheatPanelW, kCheatPanelH, 0xE0101820u);
+  snes_ovl_stroke_rect(panel, kCheatPanelW, kCheatPanelH, 8, 8,
+                       kCheatPanelW - 16, kCheatPanelH - 16, 0xFFFFD24Du);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 20,
+                     "PRACTICE CHEAT CONSOLE", 0xFFFFD24Du, 2);
+  char line[64];
+  snprintf(line, sizeof(line), "> %s", g_cheat_input);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 72, line, 0xFFFFFFFFu, 2);
+  snprintf(line, sizeof(line), "%.30s", g_cheat_status);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 112, line, 0xFF8FE3FFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 160,
+                     "invincible  swim", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 188,
+                     "lives N  music HEX", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 216,
+                     "map M X Y", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 244,
+                     "teleport ROOM", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 272,
+                     "complete  close", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 316,
+                     "help  show commands", 0xFFFFFFFFu, 2);
+  snes_ovl_draw_text(panel, kCheatPanelW, kCheatPanelH, 24, 356,
+                     "ESC CLOSES", 0xFFFFB0B0u, 2);
+  *out = panel;
+  *out_w = kCheatPanelW;
+  *out_h = kCheatPanelH;
+  return true;
+}
