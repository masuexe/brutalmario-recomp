+static void CheatEnsureScript(void) {
+  if (!g_script_entries) {
+    g_script_cap = 64;
+    g_script_entries = (ScriptEntry *)malloc((size_t)g_script_cap * sizeof(ScriptEntry));
+    g_script_count = 0;
+  }
+}
+
+static void CheatQueuePoke(uint32_t addr, const uint8_t *bytes, int count) {
+  CheatEnsureScript();
+  ScriptEntry *e = NewScriptEntry(&g_script_cap);
+  e->mask = kScriptPoke;
+  e->poke_addr = addr;
+  e->poke_bytes = (uint8_t *)malloc((size_t)count);
+  if (e->poke_bytes) memcpy(e->poke_bytes, bytes, (size_t)count);
+  e->poke_count = count;
+  e->hold_frames = 1;
+}
+
+static void CheatQueueWait(int frames) {
+  CheatEnsureScript();
+  ScriptEntry *e = NewScriptEntry(&g_script_cap);
+  e->mask = 0;
+  e->wait_frames = frames;
+  e->hold_frames = 0;
+}
+
+static void CheatQueuePress(uint32_t mask, int frames) {
+  CheatEnsureScript();
+  ScriptEntry *e = NewScriptEntry(&g_script_cap);
+  e->mask = mask;
+  e->hold_frames = frames;
+  if (mask & 0x000fffu) g_script_controllers |= 1u;
+  if (mask & 0xfff000u) g_script_controllers |= 2u;
+}
+
+static void CheatQueueBegin(void) {
+  CheatEnsureScript();
+  const int first = g_script_count;
+  (void)first;
+}
+
+static void CheatQueueFinish(int first) {
+  if (g_script_index >= first) {
+    g_script_index = first;
+    g_script_phase = 1;
+    g_script_counter = g_script_entries[first].wait_frames;
+    g_script_quit = 0;
+  }
+}
+
+static void CheatQueueMap(int map, int x, int y) {
+  const int first = g_script_count;
+  const uint8_t map_bytes[2] = {(uint8_t)map, (uint8_t)map};
+  const uint8_t coords[4] = {(uint8_t)x, (uint8_t)(x >> 8), (uint8_t)y, (uint8_t)(y >> 8)};
+  const uint8_t tiles[4] = {(uint8_t)(x >> 4), (uint8_t)(x >> 12),
+                            (uint8_t)(y >> 4), (uint8_t)(y >> 12)};
+  const uint8_t mode[1] = {0x0b};
+  CheatQueuePoke(0x1f11, map_bytes, 2);
+  CheatQueuePoke(0x1f17, coords, 4);
+  CheatQueuePoke(0x1f1f, tiles, 4);
+  CheatQueuePoke(0x0100, mode, 1);
+  CheatQueueWait(240);
+  CheatQueueFinish(first);
+}
+
+static void CheatQueueRoom(int room) {
+  const int first = g_script_count;
+  static const uint8_t map_value[2] = {0x06, 0x06};
+  static const uint8_t map_coords[8] = {0x28, 0x01, 0xe8, 0x01, 0x28, 0x01, 0xe8, 0x01};
+  static const uint8_t map_tiles[8] = {0x12, 0x00, 0x1e, 0x00, 0x12, 0x00, 0x1e, 0x00};
+  static const uint8_t mode[1] = {0x0b};
+  static const uint8_t transition[1] = {0x6a};
+  static const uint8_t player[4] = {0x80, 0x00, 0x40, 0x01};
+  static const uint8_t zero[2] = {0x00, 0x00};
+  static const uint8_t action[1] = {0x06};
+  const uint8_t room_bytes[2] = {(uint8_t)(room & 0xFF), (uint8_t)(4 + (room >> 8))};
+  CheatQueuePoke(0x1f11, map_value, 2);
+  CheatQueuePoke(0x1f17, map_coords, 8);
+  CheatQueuePoke(0x1f1f, map_tiles, 8);
+  CheatQueuePoke(0x0100, mode, 1);
+  CheatQueueWait(240);
+  CheatQueuePoke(0xd7e2, transition, 1);
+  CheatQueuePress(0x0002, 2);
+  CheatQueueWait(240);
+  CheatQueuePoke(0x94, player, 4);
+  CheatQueuePoke(0x19b8, room_bytes, 2);
+  CheatQueuePoke(0x88, zero, 2);
+  CheatQueuePoke(0x71, action, 1);
+  CheatQueueWait(180);
+  CheatQueueFinish(first);
+}
