+/* Palette RAM is raster-visible state too: HDMA may temporarily change a
+ * color and restore it later in the same field. End-of-field CGRAM alone
+ * cannot reconstruct that picture. Keep the shared two-write port latch. */
+typedef struct {
+  uint16_t colors[256];
+  uint8_t pointer, buffer;
+  bool second;
+} PpuRasterPalette;
+
+static void raster_palette_save(PpuRasterPalette *dst, const Ppu *ppu) {
+  memcpy(dst->colors, ppu->cgram, sizeof(dst->colors));
+  dst->pointer = ppu->cgramPointer;
+  dst->buffer = ppu->cgramBuffer;
+  dst->second = ppu->cgramSecondWrite;
+}
+
+static void raster_palette_restore(Ppu *ppu, const PpuRasterPalette *src) {
+  memcpy(ppu->cgram, src->colors, sizeof(src->colors));
+  ppu->cgramPointer = src->pointer;
+  ppu->cgramBuffer = src->buffer;
+  ppu->cgramSecondWrite = src->second;
+}
