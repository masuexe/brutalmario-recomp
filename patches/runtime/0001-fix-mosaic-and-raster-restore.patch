+/* PPU2's read bus belongs to a PPU instance, independently of CPU open bus.
+ * Keep this extension outside the pinned public struct layout. */
+typedef struct PpuReadBus {
+  Ppu *owner;
+  struct PpuReadBus *next;
+  uint8_t value;
+} PpuReadBus;
+static PpuReadBus *s_read_buses;
+static PpuReadBus *ppu_read_bus(Ppu *ppu) {
+  for (PpuReadBus *p = s_read_buses; p; p = p->next)
+    if (p->owner == ppu) return p;
+  PpuReadBus *p = calloc(1, sizeof(*p));
+  if (!p) abort();
+  p->owner = ppu; p->next = s_read_buses; s_read_buses = p;
+  return p;
+}
+
