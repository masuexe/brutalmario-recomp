+static void SettingsApplySelected(int delta) {
+  if (g_settings_cursor == 0) {
+    SettingsStepLanguage(delta);
+  } else if (g_settings_cursor == 1) {
+    snesrecomp_desktop_set_widescreen(!g_config.widescreen);
+  } else if (g_settings_cursor == 2) {
+    g_config.no_sprite_limits = !g_config.no_sprite_limits;
+    WriteConfigFile(g_active_config_file);
+  }
+}
+
 static void SettingsKeyDown(int key, int repeat) {
   (void)repeat;
   if (key == SDLK_ESCAPE || key == SDLK_o) {
     g_settings_menu_open = 0;
     return;
   }
-  if (key == SDLK_LEFT) {
-    SettingsStepLanguage(-1);
+  if (key == SDLK_UP) {
+    g_settings_cursor = (g_settings_cursor + 2) % 3;
+  } else if (key == SDLK_DOWN) {
+    g_settings_cursor = (g_settings_cursor + 1) % 3;
+  } else if (key == SDLK_LEFT) {
+    SettingsApplySelected(-1);
   } else if (key == SDLK_RIGHT || key == SDLK_RETURN ||
              key == SDLK_KP_ENTER || key == SDLK_SPACE) {
-    SettingsStepLanguage(+1);
+    SettingsApplySelected(+1);
   } else if (key == SDLK_1) {
     snes_host_set_language_mode("en");
   } else if (key == SDLK_2) {
     snes_host_set_language_mode("ja");
   } else if (key == SDLK_3) {
     snes_host_set_language_mode("auto");
+  } else if (key == SDLK_4 || key == SDLK_w) {
+    snesrecomp_desktop_set_widescreen(!g_config.widescreen);
+  } else if (key == SDLK_5) {
+    g_config.no_sprite_limits = !g_config.no_sprite_limits;
+    WriteConfigFile(g_active_config_file);
   }
