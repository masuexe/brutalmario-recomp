+        memcmp(next, header, sizeof(header)) != 0) {
+      /* Older states have no separate echo history. Do not consume the
+       * following APU state; start with a silent feedback buffer. */
+      if (echo) memset(echo->ram, 0, sizeof(echo->ram));
+      return;
+    }
+    sli->func(sli, header, sizeof(header));
+    if (echo) sli->func(sli, echo->ram, sizeof(echo->ram));
+    else {
+      uint8_t discard[65536];
+      sli->func(sli, discard, sizeof(discard));
+    }
+  } else if (echo) {
+    sli->func(sli, header, sizeof(header));
+    sli->func(sli, echo->ram, sizeof(echo->ram));
