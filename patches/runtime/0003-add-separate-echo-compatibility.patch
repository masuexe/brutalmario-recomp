+/* Explicit compatibility mode for legacy music engines that permit echo
+ * addresses to wrap into SPC program RAM. Default hardware behavior remains
+ * shared RAM. Each DSP owns independent echo storage, including save state. */
+typedef struct DspEchoStorage {
+  Dsp *owner;
+  struct DspEchoStorage *next;
+  uint8_t ram[65536];
+} DspEchoStorage;
+static DspEchoStorage *s_echo_storage;
+
+static DspEchoStorage *echo_storage(const Dsp *dsp) {
+  for (DspEchoStorage *p = s_echo_storage; p; p = p->next)
+    if (p->owner == dsp) return p;
+  return NULL;
+}
+
 Dsp* dsp_init(uint8_t *ram) {
   Dsp* dsp = calloc(1, sizeof(Dsp));  /* zero padding: saveload/co-sim hash determinism */
+  const char *compat = getenv("SNESRECOMP_SEPARATE_ECHO");
+  if (compat && strcmp(compat, "1") == 0) {
+    DspEchoStorage *p = calloc(1, sizeof(*p));
+    if (!p) { free(dsp); return NULL; }
+    p->owner = dsp;
+    p->next = s_echo_storage;
+    s_echo_storage = p;
+  }
   dsp->apu_ram = ram;
   dsp->shadow = dsp_shadow_create();  // opt-in; NULL/disabled unless env set
   return dsp;
 }
 
 void dsp_free(Dsp* dsp) {
+  DspEchoStorage **p = &s_echo_storage;
+  while (*p && (*p)->owner != dsp) p = &(*p)->next;
+  if (*p) { DspEchoStorage *old = *p; *p = old->next; free(old); }
   dsp_shadow_free((DspShadow*)dsp->shadow);
   free(dsp);
 }
 
