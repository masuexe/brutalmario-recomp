+/* Completion credits are the sole output clock. SDL's dummy-device timer
+ * would add a second sleep after each Windows completion, then catch up in
+ * bursts. Keep its device paused and consume on a dedicated stoppable thread. */
+static bool WindowsAudioReady(int fd, short events) {
+  while (!SDL_AtomicGet(&g_windows_audio_stop)) {
+    struct pollfd pending = {fd, events, 0};
+    int ready = poll(&pending, 1, 50);
+    if (ready < 0 && errno == EINTR) continue;
+    if (ready < 0) return false;
+    if (!ready) continue;
+    return (pending.revents & events) != 0;
+  }
+  return false;
+}
+
+static int WindowsAudioThread(void *unused) {
+  (void)unused;
+  SDL_SetThreadPriority(SDL_THREAD_PRIORITY_HIGH);
+  Uint8 pcm[512 * 2 * sizeof(int16)];
+  bool have_credit = false;
+  while (!SDL_AtomicGet(&g_windows_audio_stop)) {
+    if (SDL_AtomicGet(&g_windows_audio_paused)) {
+      SDL_Delay(5);
+      continue;
+    }
+    if (!have_credit) {
+      char credit;
+      if (!WindowsAudioReady(g_windows_audio_ack_fd, POLLIN)) break;
+      ssize_t received;
+      do { received = read(g_windows_audio_ack_fd, &credit, 1); }
+      while (received < 0 && errno == EINTR);
+      if (received != 1) break;
+      have_credit = true;
+      /* Preserve a credit acquired while the main thread was pausing. */
+      if (SDL_AtomicGet(&g_windows_audio_paused)) continue;
+    }
+    FillAudioBuffer(pcm, sizeof(pcm));
+    int offset = 0;
+    while (offset < (int)sizeof(pcm)) {
+      if (!WindowsAudioReady(g_windows_audio_fd, POLLOUT)) goto finished;
+      ssize_t written = write(g_windows_audio_fd, pcm + offset, sizeof(pcm) - offset);
+      if (written < 0 && errno == EINTR) continue;
+      if (written <= 0) goto finished;
+      offset += (int)written;
+    }
+    have_credit = false;
+  }
+finished:
+  if (!SDL_AtomicGet(&g_windows_audio_stop))
+    host_report_breadcrumb("Windows audio channel closed; continuing without sound");
+  close(g_windows_audio_fd);
+  close(g_windows_audio_ack_fd);
+  /* Only this thread owns the descriptors after creation. */
+  return 0;
+}
+#endif
