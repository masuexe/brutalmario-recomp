--- a/runner/src/beam_frame_driver.c
+++ b/runner/src/beam_frame_driver.c
@@ -14,6 +14,7 @@
 #include "common_cpu_infra.h"
 #include "common_rtl.h"
 #include "cpu_state.h"
+#include "ppu_dma_trace.h"
 #include "snes/cart.h"
 #include "snes/cx4.h"
 #include "snes/dma.h"
@@ -107,7 +108,15 @@
    * already starts where the real CPU would take it. */
   cpu_push_interrupt_frame_at(&g_cpu, s_resume_pc);
   interp_bridge_set_master_deadline(deadline);
-  (void)interp_bridge_run_interrupt(&g_cpu, vector);
+  /* Run on the resumable scheduler path. A handler may span fields (for
+   * example an SPC upload); running it atomically through RTI ignores the
+   * deadline and consumes multiple hardware fields in one host call.
+   * The architectural frame remains on the guest stack across a yield;
+   * RTI restores the interrupted PC naturally when execution resumes. */
+  ppudma_note_interrupt(g_snes && g_snes->inNmi);
+  (void)interp_bridge_run_until_quiescent(&g_cpu, vector);
+  if (interp_bridge_lle_took_wai())
+    s_wai_halted = true;
   /* A deadline left armed stays true for every AOT block prologue afterwards
    * and turns each compiled body into an immediate yield. */
   interp_bridge_set_master_deadline(0);
@@ -139,9 +148,11 @@
     ppu_checkOverscan(g_ppu);
     ppu_handleVblank(g_ppu);
   }
-  /* The render walk owns HDMA (see draw) and the CPU half owns the H/V
-   * comparator. Re-asserted per frame: a save-state load restores Snes. */
-  snes_set_hdma_beam_enabled(g_snes, false);
+  /* HDMA belongs to the live beam: its PPU writes are guest state and
+   * journal history, even when a later field disables the channel. Running
+   * it only during scanout loses those writes when live state is restored.
+   * Re-asserted per frame: a save-state load restores Snes. */
+  snes_set_hdma_beam_enabled(g_snes, true);
   snes_set_raster_irq_beam_enabled(true);
   ppu_rasterBegin(g_ppu);

@@ -240,27 +251,16 @@
     SnesBeamRasterObserver *observer, void *context) {
   int line;

-  /* The field's register state as of its start, then each line's journal
-   * entries and HDMA in beam order. HDMA here is the real unit (dma.c), so
-   * the beam must not also step it from inside guest register writes. */
-  snes_set_hdma_beam_enabled(g_snes, false);
+  /* CPU and beam-HDMA writes are already journaled in beam order. Scanout
+   * replays that history without executing DMA a second time or reading the
+   * tables after the CPU may have changed them. RenderEnd restores live state. */
   ppu_rasterRenderBegin(g_ppu);
-  dma_initHdma(g_snes->dma);
-  /* Hardware's V=0 init also performs each channel's first transfer before
-   * any visible pixel. */
-  dma_primeHdmaFirstLine(g_snes->dma);
   for (line = 1; line <= 224; line++) {
-    uint8_t hdmaen;
-    /* A split is written in H-blank after its line is drawn, so the previous
-     * line's entries take effect on this one. */
+    /* H-blank writes on line L take effect on visible line L+1. */
     ppu_rasterApplyLine(g_ppu, line - 1);
-    if (ppu_rasterTakeHdmaen(&hdmaen))
-      dma_startDma(g_snes->dma, hdmaen, true);
     ppu_runLine(g_ppu, line);
     if (observer)
       observer(g_ppu, (unsigned)line, context);
-    /* HDMA runs in the H-blank after this line; it lands on the next. */
-    dma_doHdma(g_snes->dma);
   }
   ppu_rasterRenderEnd(g_ppu);
 }
