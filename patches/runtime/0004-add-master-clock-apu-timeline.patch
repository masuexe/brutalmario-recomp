+/* A beam-scheduled CPU already advances through WAI and long loaders.
+ * Opt-in absolute pacing avoids inventing a full APU field for a partial
+ * RESET field, and avoids per-host-call rounding/minimum drift. */
+static bool rtl_apu_master_timeline(void) {
+  static int enabled = -1;
+  if (enabled < 0) {
+    const char *value = getenv("SNESRECOMP_APU_MASTER_CLOCK");
+    enabled = value && *value && *value != '0';
+  }
+  return g_extended_frame_timing && enabled;
+}
+
+static uint64_t rtl_apu_master_cycle(uint64_t master) {
+  /* NTSC master = 236250000/11 Hz, nominal DSP = 32040 Hz, SPC = DSP*32.
+   * Their reduced SPC/master ratio is 15664/328125. The old 17088/357368
+   * assumes exactly 60 fields/sec and runs the SPC about 0.164% faster.
+   * Quotient/remainder form avoids overflowing long-running master clocks. */
+  return (master / 328125ull) * 15664ull +
+         (master % 328125ull) * 15664ull / 328125ull;
+}
