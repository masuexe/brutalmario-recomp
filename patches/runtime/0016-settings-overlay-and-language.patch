+static char HostAsciiLower(char c) {
+  return (c >= 'A' && c <= 'Z') ? (char)(c + ('a' - 'A')) : c;
+}
+
+static int HostStrEqNoCase(const char *a, const char *b) {
+  if (!a || !b) return 0;
+  while (*a && *b) {
+    if (HostAsciiLower(*a) != HostAsciiLower(*b)) return 0;
+    a++;
+    b++;
+  }
+  return *a == 0 && *b == 0;
+}
+
+static const char *NormalizeLangMode(const char *s) {
+  if (!s || !*s) return NULL;
+  if (HostStrEqNoCase(s, "en") || HostStrEqNoCase(s, "english")) return "en";
+  if (HostStrEqNoCase(s, "ja") || HostStrEqNoCase(s, "jp") ||
+      HostStrEqNoCase(s, "japanese")) return "ja";
+  if (HostStrEqNoCase(s, "auto") || HostStrEqNoCase(s, "system")) return "auto";
+  return NULL;
+}
+
+static int StartsWithJaNoCase(const char *s) {
+  return s && HostAsciiLower(s[0]) == 'j' && HostAsciiLower(s[1]) == 'a';
+}
+
+static int DetectOsLanguageCode(void) {
+  const char *test_loc = getenv("BM_LANG_TEST_LOCALE");
+  if (test_loc && *test_loc)
+    return StartsWithJaNoCase(test_loc) ? 1 : 0;
+#ifdef _WIN32
+  return PRIMARYLANGID(GetUserDefaultUILanguage()) == LANG_JAPANESE ? 1 : 0;
+#else
+  static const char *const kEnvVars[] = { "LC_ALL", "LC_MESSAGES", "LANG" };
+  for (size_t i = 0; i < sizeof(kEnvVars) / sizeof(kEnvVars[0]); i++) {
+    const char *v = getenv(kEnvVars[i]);
+    if (v && *v)
+      return StartsWithJaNoCase(v) ? 1 : 0;
+  }
+  return 0;
+#endif
+}
+
+void snes_host_register_lang_sync(snes_host_lang_sync_fn fn) {
+  g_lang_pack_sync_fn = fn;
+}
+
+const char *snes_host_get_language_mode(void) {
+  if (g_lang_boot_override[0]) return g_lang_boot_override;
+  if (g_config.language[0]) return g_config.language;
+  return "auto";
+}
+
+int snes_host_is_script_active(void) {
+  return g_settings_script_active ? 1 : 0;
+}
+
+int snes_host_get_effective_language(void) {
+  const char *mode = snes_host_get_language_mode();
+  if (strcmp(mode, "ja") == 0) return 1;
+  if (strcmp(mode, "en") == 0) return 0;
+  if (g_settings_script_active && !g_lang_boot_override[0])
+    return 0;
+  return DetectOsLanguageCode();
+}
+
+int snes_host_set_language_mode(const char *mode_in) {
+  const char *norm = NormalizeLangMode(mode_in);
+  if (!norm) return 0;
+  g_lang_boot_override[0] = 0;
+  snprintf(g_config.language, sizeof(g_config.language), "%s", norm);
+  WriteConfigFile(g_active_config_file);
+  const int eff = snes_host_get_effective_language();
+  if (g_lang_pack_sync_fn)
+    g_lang_pack_sync_fn(eff, norm);
+  fprintf(stderr, "[settings] lang=%s eff=%s\n", norm, eff ? "ja" : "en");
+  return 1;
+}
