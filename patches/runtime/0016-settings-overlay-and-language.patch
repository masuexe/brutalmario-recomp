+static void SettingsStepLanguage(int delta) {
+  static const char *const kModes[3] = { "en", "ja", "auto" };
+  const char *cur = snes_host_get_language_mode();
+  int idx = 2;
+  if (strcmp(cur, "en") == 0) idx = 0;
+  else if (strcmp(cur, "ja") == 0) idx = 1;
+  idx = (idx + (delta < 0 ? 2 : 1)) % 3;
+  snes_host_set_language_mode(kModes[idx]);
+}
+
+static void SettingsExecuteCommand(const char *raw) {
+  if (!raw) return;
+  char cmd[64];
+  size_t len = 0;
+  while (*raw == ' ' || *raw == '\t') raw++;
+  while (raw[len] && len + 1 < sizeof(cmd)) {
+    cmd[len] = raw[len];
+    len++;
+  }
+  while (len > 0 && (cmd[len - 1] == ' ' || cmd[len - 1] == '\t'))
+    len--;
+  cmd[len] = 0;
+  if (!cmd[0]) return;
+  if (HostStrEqNoCase(cmd, "en") || HostStrEqNoCase(cmd, "english")) {
+    snes_host_set_language_mode("en");
+  } else if (HostStrEqNoCase(cmd, "ja") || HostStrEqNoCase(cmd, "jp") ||
+             HostStrEqNoCase(cmd, "japanese")) {
+    snes_host_set_language_mode("ja");
+  } else if (HostStrEqNoCase(cmd, "auto") || HostStrEqNoCase(cmd, "system")) {
+    snes_host_set_language_mode("auto");
+  } else if (HostStrEqNoCase(cmd, "next") || HostStrEqNoCase(cmd, "right")) {
+    SettingsStepLanguage(+1);
+  } else if (HostStrEqNoCase(cmd, "prev") || HostStrEqNoCase(cmd, "left")) {
+    SettingsStepLanguage(-1);
+  } else if (HostStrEqNoCase(cmd, "toggle")) {
+    snes_host_set_language_mode(snes_host_get_effective_language() ? "en" : "ja");
+  } else if (HostStrEqNoCase(cmd, "close") || HostStrEqNoCase(cmd, "exit")) {
+    if (!g_overlay_dumped_menu && HostGetenv("OVERLAY_DUMP"))
+      PresentFrozenWithOverlay();
+    g_settings_menu_open = 0;
+  }
+}
+
+static void SettingsKeyDown(int key, int repeat) {
+  (void)repeat;
+  if (key == SDLK_ESCAPE || key == SDLK_o) {
+    g_settings_menu_open = 0;
+    return;
+  }
+  if (key == SDLK_LEFT) {
+    SettingsStepLanguage(-1);
+  } else if (key == SDLK_RIGHT || key == SDLK_RETURN ||
+             key == SDLK_KP_ENTER || key == SDLK_SPACE) {
+    SettingsStepLanguage(+1);
+  } else if (key == SDLK_1) {
+    snes_host_set_language_mode("en");
+  } else if (key == SDLK_2) {
+    snes_host_set_language_mode("ja");
+  } else if (key == SDLK_3) {
+    snes_host_set_language_mode("auto");
+  }
+}
+
+static void RunSettingsMenuLoop(bool *running) {
+  uint32 prev_pad = OverlayNavInputs();
+  g_settings_menu_open = 1;
+  if (!g_settings_batch_done) {
+    g_settings_batch_done = 1;
+    const char *batch = HostGetenv("SETTINGS_COMMANDS");
+    if (batch && *batch) {
+      char copy[512];
+      snprintf(copy, sizeof(copy), "%s", batch);
+      char *part = copy;
+      while (part && *part) {
+        char *sep = strchr(part, ';');
+        if (sep) *sep = 0;
+        SettingsExecuteCommand(part);
+        if (!g_settings_menu_open) break;
+        part = sep ? sep + 1 : NULL;
+      }
+    }
+  }
+  g_overlay_modal = true;
+  SetAudioPaused(true);
+  host_report_breadcrumb("settings overlay OPEN - guest frozen until it closes");
+  while (g_settings_menu_open && *running) {
+    PumpOverlayEvents(running, &SettingsKeyDown);
+    if (!*running)
+      g_settings_menu_open = 0;
+    if (g_settings_menu_open) {
+      const uint32 pad = OverlayNavInputs();
+      const uint32 pressed = pad & ~prev_pad;
+      prev_pad = pad;
+      if (pressed & SNES_PAD_LEFT)  SettingsStepLanguage(-1);
+      if (pressed & (SNES_PAD_RIGHT | SNES_PAD_A)) SettingsStepLanguage(+1);
+      if (pressed & SNES_PAD_B)     g_settings_menu_open = 0;
+    }
+    if (g_settings_menu_open)
+      PresentFrozenWithOverlay();
+    SDL_Delay(8);
+  }
+  g_settings_menu_open = 0;
+  g_overlay_modal = false;
+  ResetAudioTimeline();
+  SetAudioPaused(g_paused);
+  host_report_breadcrumb("settings overlay CLOSED - guest resuming");
+}
