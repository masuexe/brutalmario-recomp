# Wait until the goal tape sprite is loaded.
until a5 == 7b 1800
dump at_tape
# Swim to the pole and descend to the ground.
press right 60
press down 250
dump at_ground
# Clear the air-swim fixture so Mario can walk and jump normally.
forcepoke 85 00
# Walk right to the ground edge at the pole (tape X = 0x11E0 over the pit).
press right 40
dump at_edge
until 1493 != 00 0
# Goal contact already occurred during the preceding walk; no goal flags written.
forcepoke 1490 00
wait 1500
dump completed_map
until 0100 == 0e 0
until 1ecb == 8a 0
reset
wait 600
press start 2
wait 180
press start 2
wait 360
dump reloaded
until 0100 == 0e 0
until 1ecb == 8a 0
quit
