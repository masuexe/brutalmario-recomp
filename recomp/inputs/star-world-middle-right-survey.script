# Bounded entrance survey: disposable uncleared save; map coordinate shortcut.
# Clean-session input route shared by reference and native hosts.
# Map coordinate shortcut; no completion, sprite or physics writes.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180

# Practice map transfer: map 6, X=0x198, Y=0x1a8.
poke 1f11 0606
poke 1f17 9801a8019801a801
poke 1f1f 19001a0019001a00
poke 0100 0b
wait 240
dump selected
press y 2
until 0100 == 12 480
dump layout
wait 180
dump entry180
wait 420
dump entry600
quit
