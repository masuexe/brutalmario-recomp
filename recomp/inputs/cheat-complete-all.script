# Completed-progress cheat: open every saved level slot, every overworld event
# and every switch, then reload the map through the normal fade so the level
# tiles and warp stars rebuild from the new flags.
turbo on
until 0100 == 07 800
wait 10
press start 2
until 0100 == 08 300
wait 180
press start 2
until16 010b == 01c5 600
until 0100 == 14 300
wait 60
press a 2
until16 010b == 014b 600
until 0100 == 14 300
wait 60
press b 2
until16 010b == 014c 600
until 0100 == 14 300
wait 60
press a 2
until16 010b == 014d 600
until 0100 == 14 300
wait 60
press b 2
# Wait for the overworld so the pokes land after the save-to-WRAM copy.
until 0100 == 0e 1200
# 96 saved level slots: clear bit plus the direction bits, no deny or midway bit.
poke 1ea2 9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f9f
# 15 overworld event bytes.
poke 1f02 ffffffffffffffffffffffffffffff
# Four switch palaces.
poke 1f27 01010101
# Synthetic completion counter.
poke 1f2e 60
# Saved per-translevel coin bitset.
poke 1f2f ffffffffffffffffffffffff
# Two custom midway masks at $7F:182C.
poke 1182c 000000000000000000000000000000000000000000000000
poke 0109 00
# Reload the map through loader mode $0B.
poke 0100 0b
wait 240
until 0100 == 0e 600
wait 60
turbo off
