# Clean-session input route shared by reference and native hosts.
# No WRAM pokes or imported savestates. All waits are guest-frame counts.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
dump map
press y 30
wait 180
dump level-entry
# Diagnostic cue: match the pinned ROM star handler at $01C580.
# Activate the guest star timer and request its normal song; no SPC/RAM patch.
poke 1490 ff
poke 1dfb 0d
# The route has $0DDA=$30 here; the handler sets its high bit.
poke 0dda b0
wait 600
dump star-ten-seconds
wait 300
dump star-tail
quit
