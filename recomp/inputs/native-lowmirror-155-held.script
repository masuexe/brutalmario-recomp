# Held-position fixture exercises actor31 motion/despawn; not traversal.
# Map/position/destination/pipe/immunity fixtures; no actor, HP, progress, completion or save writes.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
poke 1f11 0000
poke 1f17 b8015801b8015801
poke 1f1f 1b0015001b001500
poke 0100 0b
wait 240
dump node
press y 2
until 0100 == 14 500
dump active
forcepoke 1497 ff
poke 94 80004001
poke 19b8 55
poke 19d8 05
poke 88 0000
poke 71 06
until 010b == 55 500
until 0100 == 14 500
pokefor 94 8001f000 90
dump entry
pokefor 94 8001f000 60
dump mid
pokefor 94 8001f000 60
dump motion
pokefor 94 8001f000 120
dump after
quit
