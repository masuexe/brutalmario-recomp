dump fly160
# Final position alignment over the real goal platform; no goal/progress writes.
forcepoke 85 00
poke 94 00118000
poke 7b 00
poke 7d 00
press right 180
until 1493 != 00 180
dump goal
wait 900
dump completed_map
until 0100 == 0e 0
until 1efe == 8f 0
# Follow the actual map destination before resetting; no extra teleport.
press y 2
wait 600
dump castle_entry
reset
wait 600
press start 2
wait 180
press start 2
wait 600
dump file_reload
# Re-entry fixture selects the previously cleared course, preserving save flags.
poke 1f11 0000
poke 1f17 a800d801a800d801
poke 1f1f 0a001d000a001d00
poke 0100 0b
wait 240
dump reload_node
press y 2
wait 600
dump reload_course
until 0100 == 14 0
until16 010b == 0138 0
quit
