# Coordinate/damage-immunity shortcuts to five actual coins, existing goal and File A reload.
# No DK, coin counters, completion, save bytes or exit destinations are poked.
wait 600
press start 2
wait 180
press start 2
wait 900
press b 30
wait 180
press a 30
wait 180


# Practice map transfer: map 6, X=0x128, Y=0x168.
poke 1f11 0606
poke 1f17 2801680128016801
poke 1f1f 1200160012001600
poke 0100 0b
wait 240
dump selected
press y 2
until 0100 == 12 360
dump layout
until 0100 == 13 360
dump graphics
until 0100 == 14 360
dump active
wait 30
dump standing
forcepoke 1497 ff

poke 94 8001b00b
poke 7b 0000
wait 6
dump coin1
poke 94 2000300a
poke 7b 0000
wait 6
dump coin2
poke 94 1000b006
poke 7b 0000
wait 6
dump coin3
poke 94 4000b005
poke 7b 0000
wait 6
dump coin4
poke 94 d0011003
poke 7b 0000
wait 6
dump coin5
# Hold only the player coordinates while the vertical camera catches up.
# Release the hold; real left input enters the existing horizontal pipe.
poke 7d 00
pokefor 94 9001a008 600
dump pipe_ready
press left+y 60
wait 240
dump goal_room
poke 94 60014001
press right 60
wait 960
dump saved_map
reset
wait 600
press start 2
wait 180
press start 2
wait 600
dump file_reload
poke 1f11 0606
poke 1f17 2801680128016801
poke 1f1f 1200160012001600
poke 0100 0b
wait 240
dump reload_node
press y 2
wait 360
dump reload_reentry
quit
