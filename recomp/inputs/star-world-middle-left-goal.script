# Middle-left normal clear. Same inputs on reference and native.
# Map teleport is the only position poke. No hit counter, boss state, $71, or $1493 writes.
# Both hosts return to mode $0E at $010E,$012E with $13CE=1 and translevel $03 flagged $8C.
# File A reload keeps $8C in both SRAM copies ($0003 and $01B0).
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
dump map

