# Negative branch-entry control: identical position/immunity fixture, Down input.
# No pipe action, actor, destination or completion writes.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
poke 1f11 0000
poke 1f17 b8015801b8015801
poke 1f1f 1b0015001b001500
poke 0100 0b
wait 240
dump node
press y 2
until 0100 == 14 500
dump active
forcepoke 1497 ff
poke 94 20036001
wait 30
dump before_branch
press down 20
wait 240
dump branch
until 010b == 1f 0
quit
