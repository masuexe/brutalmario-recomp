# Upper-inner entrance after restoring room 007 graphics.
# Clean-session input route shared by reference and native hosts.
# No WRAM pokes or imported savestates. All waits are guest-frame counts.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
dump map

# Practice map transfer: map 6, X=0x178, Y=0x188.
poke 1f11 0606
poke 1f17 7801880178018801
poke 1f1f 1700180017001800
poke 0100 0b
wait 240
dump selected
press y 2
until 0100 == 14 480
dump active
wait 180
dump entry180
wait 420
dump entry600
quit
