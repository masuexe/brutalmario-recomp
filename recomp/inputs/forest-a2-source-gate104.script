# Diagnostic official source primary104 entry from naturally entered Baby Yoshi Hill.
# Forced destination/position/pipe action, no completion or save writes.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
dump map
press right 30
wait 180
press right 30
wait 180
dump hill-map
press y 30
wait 240
dump hill-entry
poke 19b8 04
poke 19d8 05
poke 94 80006001
poke 88 0000
poke 71 06
until 010b == 04 500
until 0100 == 14 500
dump gate104
wait 240
dump gate104_after
quit
