# Assisted 1-2 route: room010 -> room04A -> room161 -> real goal -> next course.
# Fresh session, no imported state. Map/position, upward launch, air-swim and
# invulnerability fixtures skip traversal obstacles. This does not prove an
# unassisted full-course route. Sprite power-up, both pipe entries, goal contact
# and completion/event writes are performed by the game, not injected.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
poke 0109 00

# Practice map transfer: map 0, X=0x018, Y=0x1b8.
poke 1f11 0000
poke 1f17 1800b8011800b801
poke 1f1f 01001b0001001b00
poke 0100 0b
wait 240
dump selected
press y 2
wait 180
dump entry180
wait 420
dump entry600
