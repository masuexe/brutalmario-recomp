# Map/node fixture enters room 146, then a labelled pipe-action transfer enters 0FF.
# No sprite, completion or HP writes. Not an unassisted traversal or fight clear.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
# Survey: override the map 6 lower-left node level and enter it.
poke 1f11 0606
poke 1f17 2801e8012801e801
poke 1f1f 12001e0012001e00
poke 0100 0b
wait 240
poke d7e2 6a
press y 2
wait 240
dump approach146
# Seven Koopalings entry boundary only; labelled pipe-action room transfer.
# No invulnerability, completion writes, imported saves or forced movement.
poke 94 80004001
poke 19b8 ff
poke 19d8 04
poke 88 0000
poke 71 06
wait 180
dump fight180
wait 420
dump fight600
wait 600
dump fight1200
wait 1200
dump fight2400

# Ordinary button inputs to dismiss Boss instructions and exercise initial attacks.
press b 2
wait 180
dump after_b
press a 2
wait 180
dump after_a
press x 2
wait 180
dump after_x
press y 2
wait 180
dump after_y

# Read-only event waits align the first spawned child across different engine clocks.
# Entry remains a map/node + pipe-action fixture. No HP or completion writes.
until cb == 03 1800
until 1aba4 == e0 600
dump child_spawn
wait 32
dump child32
wait 64
dump child96
# Native-only real death/map/re-entry check. No forced death flag or HP write.
until 71 == 09 900
dump child_death
until 0100 == 0e 1200
# Allow the ordinary overworld entry animation to finish before re-entry input.
wait 120
dump child_map
press y 2
wait 240
dump child_course_reentry
# Explicit pipe-action boundary back into the experimental fight.
poke 94 80004001
poke 19b8 ff
poke 19d8 04
poke 88 0000
poke 71 06
wait 180
dump child_fight_reentry
quit
