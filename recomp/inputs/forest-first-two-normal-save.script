# Assisted linked normal goals: Fishing Spree -> bridge -> shack entry.
# Map position and held position for the first goal; position, pipe action
# and damage immunity for the bridge. Onward map walking and entry are natural.
# No node assignment, completion, exit, sprite, event or save edits.
# Clean-session input route shared by reference and native hosts.
# No WRAM pokes or imported savestates. All waits are guest-frame counts.
wait 600
dump title
press start 2
wait 180
dump files
press start 2
wait 900
dump intro
press b 30
wait 180
press a 30
wait 180
poke 1f11 0000
poke 1f17 e800a801e800a801
poke 1f1f 0e001a000e001a00
poke 0100 0b
wait 240
dump node
press y 2
until 0100 == 14 500
dump active
forcepoke 1497 ff
pokefor 94 80118000 60
dump before_goal
press right 120
dump touched
wait 900
dump clear_map
# The first clear leaves Mario at the real bridge node. No map fixture here.
press y 2
until 0100 == 14 500
dump bridge_active
poke 94 800b6001
poke 88 0000
poke 71 06
wait 240
dump bridge_goal_room
pokefor 94 40014001 60
dump bridge_before_goal
press right 90
dump bridge_touched
wait 900
dump bridge_clear_map
reset
wait 600
press start 2
wait 180
press start 2
wait 600
dump bridge_file_reload
# The second clear leaves Mario at the real shack node. No map fixture here.
press y 2
until 0100 == 14 500
dump shack_entry
quit
